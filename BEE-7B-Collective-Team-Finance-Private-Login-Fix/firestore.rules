rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function approved() { return signedIn() && myProfile().approved == true; }
    function admin() { return approved() && myProfile().role in ['owner','admin']; }
    function owner() { return approved() && myProfile().role == 'owner'; }
    function validNewMember(userId) {
      return signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email','first_name','last_name','requested_role','requested_group_id','phone','role','approved','member_id','created_at'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'member'
        && request.resource.data.approved == false
        && request.resource.data.member_id == null
        && request.resource.data.first_name is string
        && request.resource.data.last_name is string
        && request.resource.data.requested_group_id is string;
    }
    match /users/{userId} {
      allow get: if admin() || (signedIn() && request.auth.uid == userId);
      allow list: if admin();
      allow create: if validNewMember(userId);
      allow update: if admin()
        && (owner() || (
          resource.data.role != 'owner'
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved','member_id'])
        ))
        && (userId != request.auth.uid || request.resource.data.role == resource.data.role)
        && (request.resource.data.role != 'owner' || resource.data.role == 'owner')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved','member_id','role']);
      allow delete: if false;
    }
    match /system/{id} {
      allow read: if approved();
      allow create, update: if admin();
      allow delete: if false;
    }
    match /groups/{id} {
      allow read: if approved();
      allow create, update: if admin();
      allow delete: if false;
    }
    match /members/{id} {
      allow read: if approved();
      allow create, update: if admin();
      allow delete: if false;
    }
    match /projects/{id} {
      allow read: if approved();
      allow create, update: if admin();
      allow delete: if false;
    }
    match /ledger_entries/{id} {
      allow read: if approved();
      allow create, update: if admin();
      allow delete: if false;
    }
    match /expense_shares/{id} {
      allow read: if approved();
      allow create: if admin();
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
